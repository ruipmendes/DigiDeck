{
  "version": 1,
  "exportedAt": "2026-08-26T00:00:00.000Z",
  "title": "Stream Focused",
  "description": "OBS controls with live REC / STREAM timers, scene switcher (auto scene previews), audio mixer, per-app ducking, Twitch chat + moderation. Built for live streamers.",
  "layout": {
    "navigation": "tabs",
    "pages": [
      {
        "id": 0,
        "name": "Stream",
        "icon": "video",
        "cols": 3,
        "buttons": [
          { "kind": "button", "id": 0,  "label": "REC\n{obs.recordingTime}",     "icon": "obs",         "action": { "type": "obs", "op": "toggle-record" } },
          { "kind": "button", "id": 1,  "label": "STREAM\n{obs.streamingTime}",  "icon": "video",       "action": { "type": "obs", "op": "toggle-stream" } },
          { "kind": "button", "id": 2,  "label": "Drops\n{obs.droppedFrames}",   "icon": "zap",         "action": { "type": "obs", "op": "toggle-record" } },
          { "kind": "button", "id": 3,  "label": "Save\nReplay",                 "icon": "save",        "action": { "type": "obs", "op": "save-replay-buffer" } },
          { "kind": "button", "id": 4,  "label": "Clip",                         "icon": "scissors",    "action": { "type": "twitch", "op": "create-clip" } },
          { "kind": "button", "id": 5,  "label": "Marker",                       "icon": "bell",        "action": { "type": "twitch", "op": "stream-marker" } },
          { "kind": "button", "id": 6,  "label": "Virtual\nCam",                 "icon": "camera",      "action": { "type": "obs", "op": "toggle-virtual-cam" } },
          { "kind": "button", "id": 7,  "label": "Replay\nBuffer",               "icon": "refresh-cw",  "action": { "type": "obs", "op": "toggle-replay-buffer" } },
          { "kind": "button", "id": 8,  "label": "Mic\nMute",                    "icon": "mic-off",     "action": { "type": "mic", "op": "toggle-mute" } }
        ]
      },
      {
        "id": 1,
        "name": "Scenes",
        "icon": "grid",
        "cols": 2,
        "buttons": [
          { "kind": "button", "id": 10, "label": "Main",             "icon": "monitor",         "action": { "type": "obs", "op": "set-scene", "params": { "sceneName": "Main" } } },
          { "kind": "button", "id": 11, "label": "Just\nChatting",   "icon": "message-circle",  "action": { "type": "obs", "op": "set-scene", "params": { "sceneName": "Just Chatting" } } },
          { "kind": "button", "id": 12, "label": "Game",             "icon": "zap",             "action": { "type": "obs", "op": "set-scene", "params": { "sceneName": "Game" } } },
          { "kind": "button", "id": 13, "label": "BRB",              "icon": "moon",            "action": { "type": "obs", "op": "set-scene", "params": { "sceneName": "BRB" } } },
          { "kind": "button", "id": 14, "label": "Starting\nSoon",   "icon": "clock",           "action": { "type": "obs", "op": "set-scene", "params": { "sceneName": "Starting Soon" } } },
          { "kind": "button", "id": 15, "label": "Outro",            "icon": "check",           "action": { "type": "obs", "op": "set-scene", "params": { "sceneName": "Outro" } } }
        ]
      },
      {
        "id": 2,
        "name": "Audio",
        "icon": "sliders",
        "cols": 1,
        "buttons": [
          { "kind": "slider", "id": 20, "label": "Mic",     "icon": "mic",       "provider": "obs",       "inputName": "Mic/Aux" },
          { "kind": "slider", "id": 21, "label": "Desktop", "icon": "monitor",   "provider": "obs",       "inputName": "Desktop Audio" },
          { "kind": "slider", "id": 22, "label": "Discord", "icon": "discord",   "provider": "app-audio", "inputName": "Discord" },
          { "kind": "slider", "id": 23, "label": "Music",   "icon": "music",     "provider": "app-audio", "inputName": "Spotify" },
          { "kind": "slider", "id": 24, "label": "Browser", "icon": "globe",     "provider": "app-audio", "inputName": "chrome" }
        ]
      },
      {
        "id": 3,
        "name": "Chat",
        "icon": "message-circle",
        "cols": 2,
        "buttons": [
          { "kind": "button", "id": 30, "label": "!website",  "icon": "globe",         "action": { "type": "twitch", "op": "chat", "text": "!website" } },
          { "kind": "button", "id": 31, "label": "!discord",  "icon": "discord",       "action": { "type": "twitch", "op": "chat", "text": "!discord" } },
          { "kind": "button", "id": 32, "label": "!kofi",     "icon": "heart",         "action": { "type": "twitch", "op": "chat", "text": "!kofi" } },
          { "kind": "button", "id": 33, "label": "!lurk",     "icon": "eye-off",       "action": { "type": "twitch", "op": "chat", "text": "!lurk" } },
          { "kind": "button", "id": 34, "label": "!socials",  "icon": "send",          "action": { "type": "twitch", "op": "chat", "text": "!socials" } },
          { "kind": "button", "id": 35, "label": "!specs",    "icon": "settings",      "action": { "type": "twitch", "op": "chat", "text": "!specs" } },
          { "kind": "button", "id": 36, "label": "!commands", "icon": "menu",          "action": { "type": "twitch", "op": "chat", "text": "!commands" } },
          { "kind": "button", "id": 37, "label": "!uptime",   "icon": "clock",         "action": { "type": "twitch", "op": "chat", "text": "!uptime" } }
        ]
      },
      {
        "id": 4,
        "name": "Twitch",
        "icon": "twitch",
        "cols": 2,
        "buttons": [
          { "kind": "button", "id": 40, "label": "Shield\nMode",   "icon": "lock",       "action": { "type": "twitch", "op": "toggle-shield-mode" } },
          { "kind": "button", "id": 41, "label": "Emote\nOnly",    "icon": "star",       "action": { "type": "twitch", "op": "toggle-emote-only" } },
          { "kind": "button", "id": 42, "label": "Subs\nOnly",     "icon": "heart",      "action": { "type": "twitch", "op": "toggle-sub-only" } },
          { "kind": "button", "id": 43, "label": "Follower\nOnly", "icon": "check",      "action": { "type": "twitch", "op": "toggle-follower-only" } },
          { "kind": "button", "id": 44, "label": "Slow\nMode",     "icon": "clock",      "action": { "type": "twitch", "op": "toggle-slow-mode" } },
          { "kind": "button", "id": 45, "label": "Clear\nChat",    "icon": "x",          "action": { "type": "twitch", "op": "clear-chat" } },
          { "kind": "button", "id": 46, "label": "Run Ad\n60s",    "icon": "bell",       "action": { "type": "twitch", "op": "run-ad", "params": { "adLength": 60 } } },
          { "kind": "button", "id": 47, "label": "Snooze\nAd",     "icon": "moon",       "action": { "type": "twitch", "op": "snooze-ad" } },
          { "kind": "button", "id": 48, "label": "Shoutout",       "icon": "send",       "action": { "type": "twitch", "op": "shoutout", "prompts": [{ "field": "target", "label": "Streamer to shoutout", "placeholder": "e.g. skullbizarre" }] } }
        ]
      }
    ]
  },
  "images": {}
}
